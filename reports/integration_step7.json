      "knowledge_mcq_n10": "raw=0/10 (0%) -> fixed_prompt=3/10 (30%)",
      "code_n10": "raw=0/10 (0%) -> fixed_prompt=4/10 (40%)",
      "total_n40": "raw=4/40 (10%) -> fixed_prompt=22/40 (55%)"
    },
    "step4_buggy_per_group": {
      "math": "pass1=87/200 (43.50%), two_pass=104/200 (52.00%)",
      "science_mcq": "pass1=66/200 (33.00%), two_pass=71/200 (35.50%)",
      "knowledge_mcq": "pass1=70/300 (23.33%), two_pass=74/300 (24.67%)",
      "code": "pass1=1/100 (1.00%), two_pass=0/100 (0.00%)"
    },
    "remediation": "Fixed prompt formatting and GROUP_CAPS in kestrel/features.py, kestrel/train_verifier.py, scripts/run_step4_halting.py, and scripts/run_step7_integration.py. Re-ran all 800 checkable items on RTX 3050 for Step 7 with canonical prompts.",
    "prior_reports_status": "reports/verifier_step3.json (29.75% train / 31.25% val base accuracy) and reports/halting_step4.json (28.00% single / 31.13% two-pass) remain recorded under raw prompting and are superseded on Step 7 checkable accuracy by this canonical re-run."
